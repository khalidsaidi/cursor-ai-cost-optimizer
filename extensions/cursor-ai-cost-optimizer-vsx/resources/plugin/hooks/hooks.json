{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cco-hook.mjs\" sessionStart",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cco-hook.mjs\" beforeSubmitPrompt",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cco-hook.mjs\" preToolUse",
        "matcher": "^(Task|Write|Edit|StrReplace|MultiEdit|Delete|Shell|Bash|NotebookEdit|ApplyPatch|CreateFile|EditFile|DeleteFile)$",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cco-hook.mjs\" postToolUse",
        "matcher": "Task",
        "timeout": 8
      }
    ],
    "subagentStop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cco-hook.mjs\" subagentStop",
        "timeout": 8
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cco-hook.mjs\" beforeShellExecution",
        "matcher": ".*",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cco-hook.mjs\" sessionEnd",
        "timeout": 5
      }
    ],
    "workspaceOpen": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cco-hook.mjs\" workspaceOpen",
        "timeout": 30
      }
    ]
  }
}
