{
  "version": 2,
  "weights": {
    "complexity": 0.45,
    "risk": 0.35,
    "breadth": 0.15,
    "uncertainty": 0.1,
    "latency": -0.2
  },
  "thresholds": {
    "fastMax": 3.4,
    "balancedMax": 6.4
  },
  "guardrails": {
    "riskNoFast": 7,
    "riskForceDeep": 9
  },
  "overrideTokens": {
    "fast": "[cco:fast]",
    "balanced": "[cco:balanced]",
    "deep": "[cco:deep]",
    "auto": "[cco:auto]"
  },
  "modelOverrides": {
    "fast": "",
    "balanced": "",
    "deep": ""
  },
  "modelOverridePolicy": "best_effort",
  "discovery": {
    "auto": true,
    "refreshHours": 24,
    "probeOnInit": true,
    "maxProbesPerTier": 2,
    "excludePatterns": [
      "^auto",
      "preview",
      "image",
      "spark"
    ],
    "tierPreferences": {
      "fast": [
        "^composer-2\\.5$",
        "^composer-[0-9.]+$",
        "^claude-sonnet-5-low$",
        "^gemini-3\\.8-flash",
        "^gemini-3\\.7-flash",
        "^gemini-[0-9.]+-flash(-high)?$",
        "^gpt-5\\.6-terra-low",
        "^gpt-5\\.6-luna",
        "^cursor-grok-[0-9.]+-low$",
        "^gpt-[0-9.]+-codex-low$",
        "^gpt-[0-9.]+-(mini|nano)",
        "^kimi-k[0-9.]+-code",
        "^cursor-grok-[0-9.]+-medium$"
      ],
      "balanced": [
        "^claude-sonnet-5-thinking-high$",
        "^claude-sonnet-5-high$",
        "^cursor-grok-4\\.6-high$",
        "^gpt-5\\.6-terra-high$",
        "^claude-sonnet-[0-9.]+-thinking",
        "^cursor-grok-[0-9.]+-high$",
        "^composer-2\\.5-fast$",
        "^gpt-[0-9.]+-codex-high$",
        "^gemini-[0-9.]+-pro",
        "^composer-[0-9.]+"
      ],
      "deep": [
        "^claude-opus-5-thinking-high$",
        "^gpt-5\\.6-sol-high$",
        "^claude-sonnet-5-thinking-xhigh$",
        "^cursor-grok-4\\.6-xhigh$",
        "^claude-opus-[0-9.]+-thinking",
        "^gpt-[0-9.]+-codex-xhigh$",
        "^gpt-[0-9.]+-sol",
        "^cursor-grok-[0-9.]+-xhigh$",
        "^claude-fable-5-thinking-high$",
        "^gemini-[0-9.]+-pro"
      ]
    },
    "verifierTier": "balanced",
    "writeAgents": true
  },
  "pricing": {
    "enabled": true,
    "refreshHours": 24,
    "sourceUrl": "https://cursor.com/docs/models-and-pricing.md",
    "plan": "pro",
    "teamsTokenRatePerMillion": 0.25,
    "overrides": {}
  },
  "budgets": {
    "fast": {
      "maxFileReads": 3,
      "maxToolCalls": 6,
      "maxWebSearches": 0,
      "style": "terse",
      "expectedTokens": {
        "input": 60000,
        "output": 1500
      }
    },
    "balanced": {
      "maxFileReads": 10,
      "maxToolCalls": 20,
      "maxWebSearches": 1,
      "style": "normal",
      "expectedTokens": {
        "input": 150000,
        "output": 4000
      }
    },
    "deep": {
      "maxFileReads": 30,
      "maxToolCalls": 60,
      "maxWebSearches": 3,
      "style": "thorough",
      "expectedTokens": {
        "input": 400000,
        "output": 12000
      }
    },
    "sessionOverheadTokens": 38000
  },
  "enforcement": {
    "requireDelegation": "auto",
    "minSavingsFactor": 1.2,
    "relayOnly": true,
    "maxDenialsPerConversation": 2,
    "gatedTools": "^(Write|Edit|StrReplace|MultiEdit|Delete|Shell|Bash|NotebookEdit|ApplyPatch|CreateFile|EditFile|DeleteFile)$",
    "rewriteMisroutedTasks": true,
    "logDecisions": true,
    "readBudgetBeforeExplore": 3,
    "mode": "advise"
  },
  "escalation": {
    "cascade": true,
    "followupOnSubagentFailure": true
  },
  "learning": {
    "enabled": true,
    "emaAlpha": 0.25,
    "minObservations": 3,
    "escalateWhenErrorEmaAbove": 0.45
  },
  "shellGuard": {
    "enabled": false
  },
  "telemetry": {
    "storePromptText": false
  },
  "verification": {
    "autoRunTests": true,
    "timeoutMs": 90000
  },
  "budget": {
    "sessionUsd": 0,
    "warnAtFraction": 0.8,
    "enforce": false
  }
}
